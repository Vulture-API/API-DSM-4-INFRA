# Copie para .env; não comite credenciais. Checkouts irmãos: SERVICES_DIR=..
SERVICES_DIR=./services
BACKEND_PORT=3000
FRONTEND_PORT=3010
PROXY_PORT=8080
MQTT_PORT=1883
# Somente ambiente principal. QA substitui explicitamente por PostgreSQL interno.
DATABASE_URL=postgresql://usuario:senha@endereco/banco
# Obrigatório: segredo do JWT (32+ caracteres aleatórios). Sem ele não há login.
JWT_SECRET=
# Autorização das rotas do backend. Desligar só para depuração local.
ACCESS_CONTROL_ENABLED=true
# Monitor de estações sem comunicação e limites dos sensores (US09).
OCCURRENCES_ENABLED=true
# Conta do simulador (perfil demo) quando o controle de acesso está ligado.
SIMULADOR_EMAIL=
SIMULADOR_PASSWORD=
TEST_POSTGRES_PORT=5433
TEST_REDIS_PORT=26379
TELEMETRY_STREAM=telemetry:ingest
PERSIST_GROUP=postgres-persister
# Obrigatório: identidade desta história Redis; conservar nas retomadas/replays.
PERSIST_SOURCE_ID=
# Nunca inferir o corte. Vazio = validação estrita; corte inclusivo por Stream.
PERSIST_LEGACY_MAX_ID=
PERSIST_SHUTDOWN_TIMEOUT_SECONDS=10
PERSIST_STOP_GRACE_PERIOD=45s
PERSIST_RECOVERY_INTERVAL_SECONDS=10
PERSIST_RECOVERY_MIN_IDLE_MS=120000
PERSIST_RECOVERY_BATCH_SIZE=100
PERSIST_LEASE_REFRESH_SECONDS=10
PERSIST_LEASE_TTL_SECONDS=60
PERSIST_PROCESSING_TIMEOUT_SECONDS=30
PERSIST_METRICS_INTERVAL_SECONDS=30
INGEST_SHUTDOWN_TIMEOUT_SECONDS=30
INGEST_STOP_GRACE_PERIOD=45s
# Ativar apenas após validar todos os grupos, inclusive consumidores adicionais.
INGEST_RETENTION_ENABLED=false
INGEST_RETENTION_DAYS=7
INGEST_RETENTION_INTERVAL_SECONDS=60
INGEST_RETENTION_REQUIRED_GROUPS=["postgres-persister"]
INGEST_RETENTION_TRIM_LIMIT=10000
INGEST_RETENTION_MAX_GROUPS=128
