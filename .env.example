# Copie para .env (o docker compose lê sozinho).

# De onde vem o código dos serviços:
#   ./services  submodules deste repositório (padrão)
#   ..          pastas irmãs, para testar alterações locais antes do push
SERVICES_DIR=./services

# Portas no host, caso já estejam em uso na sua máquina.
POSTGRES_PORT=5433
MQTT_PORT=1883
