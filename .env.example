# Copie para .env; não comite credenciais.
# ./services: submodules fixados; ..: checkouts irmãos de todos os repositórios.
SERVICES_DIR=./services
BACKEND_PORT=3000
MQTT_PORT=1883
# Usada apenas no Compose principal. O overlay de testes usa outro banco.
DATABASE_URL=postgresql://usuario:senha@endereco/banco
TEST_POSTGRES_PORT=5433
